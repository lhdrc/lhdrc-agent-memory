# ============================================================================
# df-memory 评测 / 模型 API 配置（复制为 .env 后填值；.env 已被 git 忽略）
# 直接 `bun run memory -- eval ...` 即会自动读取本仓库根的 .env
# ============================================================================

# ---- 评测 LLM + Embedding 的 API Key（三者任选其一，脚本按此顺序探测）----
# 硅基流动（locomo-publish.ts 默认 base_url 即硅基流动，推荐）
SILICONFLOW_API_KEY=
# 或显式用 DF_EVAL_API_KEY 覆盖
DF_EVAL_API_KEY=
# 或复用 OpenAI 兼容 Key（需同时把 API_BASE 指向 OpenAI）
OPENAI_API_KEY=

# ---- 可选：覆盖默认模型 / 地址（不填则用 locomo-publish.ts 内置默认）----
# 默认聊天/答题/judge 模型
DF_EVAL_CHAT_MODEL=deepseek-ai/DeepSeek-V4-Flash
# 默认 embedding 模型
DF_EVAL_EMBED_MODEL=Qwen/Qwen3-Embedding-8B
# embedding 维度（Qwen3-Embedding-8B = 4096）
DF_EVAL_EMBED_DIMS=4096
# 兼容 OpenAI 的 API base
DF_EVAL_API_BASE=https://api.siliconflow.cn

# ---- 调试用（一般不必开）----
# 允许 embedding 降级哈希（语义臂区分度差，禁止当对外主分）
# DF_EVAL_MOCK_EMBED=1
# 用 mock 完成（不调真 LLM，compile/answer/judge 会失败，仅供管线冒烟）
# DF_MEMORY_MOCK_COMPLETE=1
