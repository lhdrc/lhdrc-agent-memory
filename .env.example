# 复制为 .env 后填值。`.env` 已被 git 忽略。
# `bun run memory` / `bun run evals/run.ts` 会自动读取仓库根这份文件。

# 评测 LLM：OpenCode Go（https://opencode.ai/auth）
# Go：base=https://opencode.ai/zen/go  model=hy3
# Zen 免费：base=https://opencode.ai/zen  model=hy3-free
OPENCODE_API_KEY=
DF_EVAL_LLM=auto
DF_EVAL_LLM_MODEL=hy3
DF_EVAL_LLM_BASE_URL=https://opencode.ai/zen/go
DF_EVAL_LLM_REASONING_EFFORT=low

# Embedding（Zen/Go 均无向量接口；语义臂 + dream 跨文件矛盾需要）
# OPENAI_API_KEY=
# SILICONFLOW_API_KEY=
# DF_EVAL_API_BASE=https://api.siliconflow.cn
# DF_EVAL_EMBED_MODEL=Qwen/Qwen3-Embedding-8B
# DF_EVAL_EMBED_DIMS=4096

# 评测流水线：ingest → dream(3,4) → query（默认开）
# DF_EVAL_FULL=1
# DF_EVAL_BASELINE=1
# DF_EVAL_DREAM_PHASES=3,4
# DF_EVAL_QUERY=hybrid
# DF_EVAL_SEMANTIC=0
# DF_EVAL_COMPILE_CONCURRENCY=4
# DF_EVAL_WORKSPACE_RESET=0
# DF_EVAL_STOP_AFTER=ingest
